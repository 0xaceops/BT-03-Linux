# ===== CẤU HÌNH NHÓM A6 - PHONG CÁCH NEON =====
GROUP=6                 # Phong cách 6: Neon (ưu tiên rõ đối tượng, viền sáng phát quang)
MEMBER_ID=1             # ID thành viên (1 đến 5) -> file lưu "<tên> 1.1.png"

# Địa chỉ VM-CORE: dùng IP Tailscale của máy Nhóm trưởng (vd: http://100.64.1.2:8000)
API_URL=http://100.x.y.z:8000
WORKER_TOKEN=token_bi_mat_nhom_a6
NTFY_URL=https://ntfy.sh/kho-anh-nhom-a6-secret
BARK_URL=

# ===== ĐA DẠNG HÓA MÔ HÌNH AI TRONG NHÓM =====
# Mỗi thành viên hoặc mỗi tiến trình AI có thể chọn các mô hình local khác nhau:
# 1. stabilityai/sd-turbo        (SD-Turbo: Siêu nhanh 1-2 steps, mặc định cho AI 1)
# 2. segmind/tiny-sd             (Tiny-SD: Siêu nhẹ ~600MB, rất nhanh, ít tốn RAM)
# 3. SimianLuo/LCM_Dreamshaper_v7 (LCM-Dreamshaper: Chất lượng tranh nghệ thuật cao, 2-4 steps)
# 4. nota-ai/bk-sdm-tiny         (BK-SDM: Kiến trúc tối ưu cho CPU)

AI1_MODEL_ID=stabilityai/sd-turbo
AI1_MODEL_NAME=SD-Turbo
AI1_CATEGORIES=animals,plants

AI2_MODEL_ID=segmind/tiny-sd
AI2_MODEL_NAME=Tiny-SD
AI2_CATEGORIES=food,tools

PRIORITY_ONLY=0         # 1 = máy này chỉ phục vụ người dùng tìm kiếm on-the-fly
MOCK=1                  # Đặt 1 khi test kết nối, đổi 0 khi bật AI thật
GEN_SIZE=512
OUT_SIZE=256
STEPS=2
