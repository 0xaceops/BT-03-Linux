# ===== CAU HINH RIENG CUA MOI THANH VIEN =====
GROUP=1                 # SO NHOM cua ban (1-12) -> quyet dinh phong cach anh
MEMBER_ID=1             # ID thanh vien (1,2,3,...) -> ten file se la "<ten> 1.1.png"

# Dia chi VM-CORE: dung IP Tailscale (khuyen nghi), vd http://100.64.1.2:8000
API_URL=http://100.x.y.z:8000
WORKER_TOKEN=giong_het_token_trong_core_env
NTFY_URL=https://ntfy.sh/KHO-ANH-NHOM-X-doi-ten-bi-mat
BARK_URL=               # (tuy chon) iPhone dung Bark: https://api.day.app/KEY

# AI so 1 cua ban
AI1_CATEGORIES=animals,plants
# AI so 2 (chi chay khi dung: docker compose --profile two up -d)
AI2_CATEGORIES=food,tools

PRIORITY_ONLY=0         # 1 = AI nay chi phuc vu nguoi dung tim kiem (dat o 1 may manh)
MOCK=1                  # 1 = ve hinh gia de TEST he thong. Doi thanh 0 de dung AI that
GEN_SIZE=512
OUT_SIZE=256
STEPS=2
